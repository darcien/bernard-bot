# https://discord.com/developers/applications
DISCORD_APPLICATION_ID="rubbish"
DISCORD_PUBLIC_KEY="rubbish"
DISCORD_BOT_TOKEN="rubbish"

# LLM for /chat — optional; /chat is offline when base URL or key is unset.
# Base URL without trailing /chat/completions.
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY="rubbish"
# Optional, defaults to deepseek-v4-flash.
LLM_MODEL="deepseek-v4-flash"

# Optional
# LOG_LEVEL=debug
